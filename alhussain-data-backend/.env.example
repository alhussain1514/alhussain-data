# ── Server ──
NODE_ENV=production
PORT=5000

# ── Database (MongoDB Atlas connection string) ──
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/alhussain-data?retryWrites=true&w=majority

# ── Auth ──
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ── Frontend URL (used for CORS + password reset links) ──
CLIENT_URL=https://your-frontend.vercel.app

# ── Paystack (wallet funding) ──
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxx

# ── Demboss Data API ──
# Get your token from your Demboss dashboard → Settings → API Token
DEMBOSS_BASE_URL=https://dembossdata.com/api/v1/
DEMBOSS_API_TOKEN=your-demboss-api-token-here

# Optional overrides — only needed if a purchase type returns a 404/"invalid
# action" from Demboss. Their docs don't show explicit per-action endpoint
# paths, so these are our best-guess defaults (see comment atop vtuProvider.js).
# DEMBOSS_AIRTIME_PATH=airtime
# DEMBOSS_DATA_PATH=data
# DEMBOSS_CABLE_PATH=cable
# DEMBOSS_ELECTRICITY_PATH=electricity
# DEMBOSS_EXAM_PATH=exam

# ── Initial admin account (used only by `npm run seed`) ──
SEED_ADMIN_NAME=AL-HUSSAIN Admin
SEED_ADMIN_PHONE=08000000000
SEED_ADMIN_EMAIL=admin@alhussaindata.ng
SEED_ADMIN_PASSWORD=Admin@12345
